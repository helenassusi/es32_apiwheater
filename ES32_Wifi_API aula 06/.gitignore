# ==============================
# .gitignore - HTML/CSS/JavaScript
# ==============================

# Visual Studio Code
.vscode/

# Arquivos do sistema operacional
.DS_Store
Thumbs.db
desktop.ini

# Arquivos temporários
*.tmp
*.temp
*.log

# Arquivos de backup
*.bak
*.swp
*.swo

# Dependências do Node.js
node_modules/

# Arquivos gerados pelo npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Variáveis de ambiente e informações sensíveis
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Arquivos de build
dist/
build/

# Cache
.cache/
.parcel-cache/
.vite/

# Cobertura de testes
coverage/